{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "law-school-staging",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "vars": {
    "APP_ENV": "staging"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "law-school-staging",
      "database_id": "REPLACE_WITH_STAGING_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "2100",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "AUTH_IP_LIMITER",
      "namespace_id": "2101",
      "simple": {
        "limit": 1000,
        "period": 60
      }
    },
    {
      "name": "MUTATION_LIMITER",
      "namespace_id": "2102",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
