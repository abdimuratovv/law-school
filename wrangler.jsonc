{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "law-school-local",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "vars": {
    "APP_ENV": "local"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "law-school-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787
  },
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1100",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "AUTH_IP_LIMITER",
      "namespace_id": "1101",
      "simple": {
        "limit": 1000,
        "period": 60
      }
    },
    {
      "name": "MUTATION_LIMITER",
      "namespace_id": "1102",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
